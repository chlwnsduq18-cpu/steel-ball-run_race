  "stateRules": [
    {
      "id": "charge",
      "n": "충전",
      "rule": "공통 축적 자원. spend는 보유량 중 최대 지정 수만큼 소비하고 fixPer는 소비량당 적중별 추가 피해를 준다. 부족해도 원본에서는 기본 공격이 불발하지 않는다.",
      "examples": [
        "wc_1",
        "wc_0",
        "rc_0",
        "rc_5"
      ]
    },
    {
      "id": "breath",
      "n": "호흡",
      "rule": "1~3은 회피 +5, 4부터 치명 확률 증가, 10 이상 확정 치명. 상한 12. 다음 라운드 시작부터 2 감소. 파문만의 전용 자원이 아니다.",
      "examples": [
        "breathe",
        "as_liu_8",
        "bl_wind"
      ]
    },
    {
      "id": "bleed",
      "n": "출혈",
      "rule": "공격의 각 타격 처리에서 명중 판정 전에 현재 스택만큼 피해를 받고 1 감소. bleedDmg는 상대의 출혈을 소비하지 않고 추가 피해로 참조한다.",
      "examples": [
        "hg_1",
        "hg_6",
        "kg_cut",
        "aw_phantom"
      ]
    },
    {
      "id": "rupture",
      "n": "파열",
      "rule": "공격 적중 시 현재 스택만큼 추가 피해를 받고 1 감소. 여러 번 적중하는 카드와 연계한다.",
      "examples": [
        "fissure",
        "cog",
        "shard",
        "brand"
      ]
    },
    {
      "id": "sink",
      "n": "침잠",
      "rule": "3스택당 명중 -6, 주는 피해 -1. 라운드 끝에 1 감소. sinkDmg는 같은 상태를 단계 단위 추가 피해로 활용한다.",
      "examples": [
        "sk_5"
      ]
    },
    {
      "id": "burn",
      "n": "화상",
      "rule": "라운드 끝에 지속 피해 후 스택 절반. 원본은 적이 받으면 스택×3, 플레이어는 ×2이며 적이 거는 양도 별도 보정한다. SBR 수치 조정은 공통 설정에서 한 번에 한다.",
      "examples": [
        "as_liu_0",
        "as_liu_14"
      ]
    },
    {
      "id": "shield",
      "n": "보호막",
      "rule": "추가 상태를 발명하지 않고 shield·hitShield로 부여한다. 같은 보호막이 이후 피해를 흡수한다. 최대 150.",
      "examples": [
        "hg_3",
        "wc_2",
        "as_zwei_1"
      ]
    }
  ],
  "fields": {
    "kw": "[키,양,대상] 배열. s=자신, t=상대. 공격은 적중마다, 버프·방어는 해당 카드 처리 때 적용.",
    "spend": "공통 charge에서 보유한 만큼 소비. 새 자원명이나 강제 비용 검사 없음.",
    "fixPer": "소비한 충전 1당 적중별 추가 피해.",
    "charge": "방어 카드의 충전 획득.",
    "bleedDmg": "상대 공통 출혈량에 비례한 추가 피해.",
